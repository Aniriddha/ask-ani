# Who the bot speaks as
BOT_OWNER_NAME=Ani
BOT_OWNER_EMAIL=you@example.com
BOT_SITE=my website
KNOWLEDGE_FILE=knowledge/profile.md

# Brain (Claude). Model defaults to claude-opus-5; set ASK_ANI_MODEL=claude-sonnet-5 to spend less
ANTHROPIC_API_KEY=
ASK_ANI_MODEL=claude-sonnet-5

# Voice (optional). gemini (default) or elevenlabs (stub)
VOICE_PROVIDER=gemini
GEMINI_API_KEY=
# set by npm run create-voice
GEMINI_VOICE_ID=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# any long random strings: openssl rand -base64 48
ASK_ANI_SIGNING_SECRET=
# opens your private requests page: /api/ask-ani-admin?key=...
ASK_ANI_ADMIN_KEY=

# optional phone alerts via ntfy.sh (long random string; install the ntfy app and subscribe to it)
NTFY_TOPIC=
